{
  "name": "dsh-workbay-suite",
  "version": "0.1.0",
  "private": true,
  "description": "One-shot aggregator for the DSH workbench: depends on the dock, files, terminal, gitcraft and downloader bundles and inserts all five loader rows from a single bundle patch, so the plugin list shows ONE entry.",
  "type": "module",
  "license": "MIT",
  "files": [
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-workbay-dock": "file:../dock",
    "dsh-workbay-files": "file:../files",
    "dsh-workbay-terminal": "file:../terminal",
    "dsh-gitcraft": "file:../gitcraft",
    "dsh-downloader": "file:../downloader",
    "@dsh-workbay/kit": "file:../kit"
  }
}
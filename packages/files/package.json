{
  "name": "dsh-workbay-files",
  "version": "0.1.0",
  "description": "Files page for the DSH workbench: workspace file tree, read-only viewers (text/code/image/markdown/pdf/html), and an editable CodeMirror editor loaded as a lazy chunk.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@dsh-workbay/kit": "file:../kit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test tests/host.test.mjs tests/client.test.mjs tests/editor-chunk.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "files",
    "editor",
    "viewer"
  ]
}

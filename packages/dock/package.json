{
  "name": "dsh-workbay-dock",
  "version": "0.2.2",
  "description": "Workbench dock for DeepSeek Harness: one left-sidebar entry that opens an INDEPENDENT right-hand panel hosting pages contributed by other plugins. Does not use dsh-better-sidebar. | DSH 插件：左侧栏「工作台」入口，打开一个独立的右侧面板，页面由其它插件注册；不使用 dsh-better-sidebar。",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/client.test.mjs tests/restart.test.mjs",
    "test:back": "node tests/back-stack.e2e.mjs",
    "test:tree": "node tests/files-tree.e2e.mjs",
    "test:branches": "node tests/branches.e2e.mjs",
    "test:blame": "node tests/blame-colors.e2e.mjs",
    "test:memmap": "node tests/memmap.e2e.mjs",
    "test:overlap": "node tests/dock-overlap.e2e.mjs",
    "test:monkey": "node tests/monkey.e2e.mjs 500",
    "test:visual": "node tests/visual-golden.mjs",
    "visual:update": "node tests/visual-golden.mjs --update"
  },
  "files": [
    "icon.svg",
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@dsh-workbay/kit": "file:../kit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "workbench",
    "sidebar",
    "dock"
  ]
}

{
  "name": "dsh-workbay",
  "version": "0.0.0",
  "private": true,
  "description": "DeepSeek Harness workbench: the dock host, the GitCraft and Downloader pages that register into it, the shared host kit, and a one-shot suite bundle.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "test": "pnpm -r --if-present run test",
    "test:kit": "pnpm --filter @dsh-workbay/kit run test",
    "test:gitcraft": "pnpm --filter dsh-gitcraft run test",
    "install:profile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-profile.ps1",
    "update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-from-github.ps1",
    "update:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-from-github.ps1 -SkipTests",
    "profile:snippet": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/print-profile-snippet.ps1"
  }
}
